# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored, so your keys never get committed.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# OpenAI → API keys (used server-side only, for Whisper transcription)
OPENAI_API_KEY=sk-...

# Anthropic → API keys (used server-side only, for roster scanning with Claude)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: a phone notification for each "Report a problem" (via ntfy.sh).
# A long random topic name; anyone who knows it can read the notifications,
# which only say "New BRIEFCASE problem report: <page name>". Leave unset to
# turn notifications off (reports still save).
NTFY_TOPIC=
